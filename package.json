{
  "name": "clone-class",
  "version": "2.0.0",
  "description": "Clone an ES6 Class as Another Class Name for Isolating Class Static Properties.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js",
      "default": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint src tests scripts",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test src tests/integration.test.ts",
    "test:unit:deno": "deno test --no-check --allow-read --allow-env src",
    "test:pack": "bash -x scripts/npm-pack-testing.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huan/clone-class.git"
  },
  "keywords": [
    "clone",
    "class",
    "es6",
    "static"
  ],
  "author": "Huan LI <zixia@zixia.net>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/huan/clone-class/issues"
  },
  "homepage": "https://github.com/huan/clone-class#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.0.0",
    "file-box": "^2.3.0",
    "shx": "^0.3.4",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
